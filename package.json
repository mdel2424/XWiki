{
  "name": "wikihack-mobile",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:ui": "node tests/ui.mjs",
    "index": "node scripts/pipeline.mjs sync",
    "data:setup": "node scripts/pipeline.mjs setup",
    "data:sync": "node scripts/pipeline.mjs sync",
    "data:tail": "node scripts/pipeline.mjs tail",
    "data:watch": "node scripts/pipeline.mjs watch",
    "data:status": "node scripts/pipeline.mjs status",
    "data:audit": "node scripts/pipeline.mjs audit",
    "data:fill-gaps": "node scripts/pipeline.mjs fill-gaps",
    "data:enrich": "node scripts/pipeline.mjs enrich",
    "data:export": "node scripts/pipeline.mjs export",
    "test:pipeline": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "index:algolia": "node scripts/build-index.mjs",
    "build": "node scripts/build-static.mjs",
    "package:catalog": "node scripts/package-catalog.mjs",
    "preview": "STATIC_DIR=dist node scripts/serve.mjs"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  }
}
